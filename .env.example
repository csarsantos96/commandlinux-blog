# Existing reactions (server only)
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=
# Existing translation workflow
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Newsletter: Vercel server environment and GitHub Actions secrets only
RESEND_API_KEY=

# Optional dedicated newsletter Redis. Leave both empty to reuse REDIS_KV_REST_API_* above.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Dedicated Command Linux segments, never segments from another project
RESEND_SEGMENT_PT=
RESEND_SEGMENT_EN=
NEWSLETTER_FROM="Command Linux <newsletter@commandlinux.dev>"
NEWSLETTER_SITE_URL=https://www.commandlinux.dev
# Keep false until Reach is paused and migration reconciled
NEWSLETTER_ENABLED=false
NEWSLETTER_MIGRATION_COMPLETE=false
# Optional safety mode: only this address can request confirmation;
# test Broadcasts require a dedicated segment containing exactly this one contact.
NEWSLETTER_TEST_EMAIL=

# GitHub repository variable (not required by Vercel server functions)
# Copy Project ID from the Command Linux Vercel project Settings.
NEWSLETTER_VERCEL_PROJECT_ID=
